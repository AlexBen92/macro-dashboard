# API Keys pour le dashboard
# Copiez ce fichier en .env.local et ajoutez vos clés

# ============================================
# FRED API (Federal Reserve Economic Data)
# ============================================
# Obtenez votre clé gratuitement: https://fred.stlouisfed.org/docs/api/api_key.html
# Nécessaire pour les données macro (VIX, GDP, Taux, etc.)
FRED_API_KEY=your_fred_api_key_here

# ============================================
# CoinGlass API (Données dérivées crypto)
# ============================================
# Pour données funding, OI, liquidations en temps réel
# Inscrivez-vous: https://www.coinglass.com/
COINGLASS_API_KEY=your_coinglass_api_key_here

# ============================================
# Hyperliquid (Trading crypto)
# ============================================
# Pour données de marché et exécution de trades
# Pas de clé API nécessaire pour données publiques
HYPERLIQUID_API_KEY=your_hyperliquid_api_key_here
HYPERLIQUID_ADDRESS=your_wallet_address_here

# ============================================
# DefiLlama (Données DeFi)
# ============================================
# API gratuite, pas de clé nécessaire
# Pour TVL, APY, volumes DEX
DEFILLAMA_API_KEY=optional_api_key_here

# ============================================
# Altcoins (Optionnel)
# ============================================
# CryptoQuant pour données on-chain (payant)
CRYPTOQUANT_API_KEY=your_cryptoquant_key_here

# Glassnode pour données on-chain (payant)
GLASSNODE_API_KEY=your_glassnode_key_here

# ============================================
# Configuration
# ============================================
# Mode de fonctionnement (development/production)
NODE_ENV=development

# URL de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Hermes VPS — S1 vol-surface arbitrage (read-only)
# ============================================
# Static JSON exposed by nginx (openclaw-outputs site, port 8080).
# Server-side fetch only — never exposed to the client.
VOL_ARB_SIGNAL_URL=http://srv1478830.hstgr.cloud:8080/s1-vol-arb-signal.json

# ============================================
# Hermes VPS — Vol research aggregated (VRP/D1/term/skew/S1 tearsheet+paper)
# ============================================
# Aggregated JSON produced by /root/edge_discovery/dashboard_export/build_vol_research_json.py every 30 min.
VOL_RESEARCH_URL=http://srv1478830.hstgr.cloud:8080/vol-research.json
